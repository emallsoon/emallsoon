---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
import { tiktokReferralDefault } from '../../data/fees';

const tool = tools.find((t) => t.slug === 'tiktok-shop-fee-calculator')!;
const related = tools.filter((t) => t.slug !== tool.slug).slice(0, 3);

const title = 'TikTok Shop Fee & Profit Calculator — Real Profit Per Order | emallsoon';
const description =
  'Free TikTok Shop fee calculator. Enter your current Seller Center referral rate, affiliate commission, ad spend, and costs to see profit per order. No signup.';
const tiktokAcademySource = 'https://seller-us.tiktok.com/university/home?identity=1';
const verifiedDate = '2026-11-12';

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'TikTok Shop Fee Calculator',
  url: 'https://emallsoon.com/tools/tiktok-shop-fee-calculator/',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  description:
    'Free TikTok Shop fee and profit calculator with an editable referral rate, affiliate commissions, ad spend, returns cost, and profit per order.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://emallsoon.com/' },
    { '@type': 'ListItem', position: 2, name: 'TikTok Shop Fee Calculator', item: 'https://emallsoon.com/tools/tiktok-shop-fee-calculator/' },
  ],
};

const faqs = [
  {
    q: 'How much does TikTok Shop charge sellers?',
    a: 'TikTok Shop US referral fees can change by effective date and category. TikTok’s public Seller Academy search currently exposes an August 4, 2026 referral-fee update, while the older public category table previously used by this calculator now returns 404. To avoid presenting an unverified rate, the calculator starts at 0% and requires the current rate shown in your Seller Center fee statement or category policy.',
  },
  {
    q: 'Why is there no default TikTok Shop referral rate?',
    a: 'A single preset cannot safely represent TikTok Shop’s current category and effective-date rules, and the newest publicly indexed official update is not available as a live public article. Entering the rate from Seller Center is more reliable than using a stale universal percentage.',
  },
  {
    q: 'How should I enter affiliate commission?',
    a: 'Enter the commission percentage you actually offered and the share of orders attributed to affiliates. The calculator blends those two inputs instead of assuming every order pays a creator commission.',
  },
  {
    q: 'How should I model refunds and returns?',
    a: 'Enter your expected refund and returns cost per order using your own statement history. This can include non-refunded platform charges, return shipping, handling, and write-offs. The calculator no longer hard-codes a refund administration formula because the current public policy could not be re-verified.',
  },
  {
    q: 'Why is my TikTok Shop profit lower than expected?',
    a: 'Referral fees are only one part of order economics. Add the affiliate commission, affiliate-attributed order share, ad spend, fulfillment, expected returns cost, and product cost from your own account data to see the full margin.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

---

<BaseLayout
  title={title}
  description={description}
  path={tool.href}
  jsonLd={[softwareJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <section class="section--tight section">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/#tools">Tools</a><span class="sep">/</span>
        <span>TikTok Shop Fee Calculator</span>
      </nav>

      <header class="page-head">
        <p class="eyebrow">TikTok Shop · free · no signup</p>
        <h1>TikTok Shop Fee Calculator</h1>
        <p class="lede">
          Enter the current referral rate from your Seller Center statement,
          then stack affiliate commissions, ad spend, fulfillment, and returns
          to see profit per order without relying on a stale universal preset.
        </p>
      </header>

      <div class="calc-grid">
        <form class="calc-form" id="tt-form" autocomplete="off">
          <div class="form-sec">
            <p class="fs-title">Order details</p>
            <div class="form-grid">
              <div class="field">
                <label for="price">Selling price</label>
                <div class="input-shell">
                  <span class="affix">$</span>
                  <input type="number" id="price" value="30.00" min="0" step="0.01" inputmode="decimal" />
                </div>
              </div>
              <div class="field">
                <label for="referral">Current referral fee</label>
                <div class="input-shell">
                  <input type="number" id="referral" value={tiktokReferralDefault} min="0" max="100" step="0.1" inputmode="decimal" />
                  <span class="affix">%</span>
                </div>
                <span class="hint">Required: copy your category rate from Seller Center</span>
              </div>
              <div class="field">
                <label for="shipping">Shipping charged to buyer</label>
                <div class="input-shell">
                  <span class="affix">$</span>
                  <input type="number" id="shipping" value="0.00" min="0" step="0.01" inputmode="decimal" />
                </div>
                <span class="hint">If free shipping, enter 0</span>
              </div>
            </div>
          </div>

          <div class="form-sec">
            <p class="fs-title">Costs per order</p>
            <div class="form-grid">
              <div class="field">
                <label for="cost">Product cost <span class="opt">(landed)</span></label>
                <div class="input-shell">
                  <span class="affix">$</span>
                  <input type="number" id="cost" value="9.00" min="0" step="0.01" inputmode="decimal" />
                </div>
                <span class="hint">Unit cost incl. inbound shipping</span>
              </div>
              <div class="field">
                <label for="fulfillment">Fulfillment / shipping you pay</label>
                <div class="input-shell">
                  <span class="affix">$</span>
                  <input type="number" id="fulfillment" value="4.00" min="0" step="0.01" inputmode="decimal" />
                </div>
                <span class="hint">FBT pick-pack or your 3PL cost</span>
              </div>
              <div class="field">
                <label for="affiliate">Affiliate commission</label>
                <div class="input-shell">
                  <input type="number" id="affiliate" value="10" min="0" max="100" step="0.5" inputmode="decimal" />
                  <span class="affix">%</span>
                </div>
                <span class="hint">Creator commission on affiliate sales</span>
              </div>
              <div class="field">
                <label for="affiliate-share">% of sales from affiliates</label>
                <div class="input-shell">
                  <input type="number" id="affiliate-share" value="50" min="0" max="100" step="5" inputmode="decimal" />
                  <span class="affix">%</span>
                </div>
                <span class="hint">Blended: 40–60% is common</span>
              </div>
              <div class="field">
                <label for="ads">Ad spend per order</label>
                <div class="input-shell">
                  <span class="affix">$</span>
                  <input type="number" id="ads" value="6.00" min="0" step="0.01" inputmode="decimal" />
                </div>
                <span class="hint">Or monthly ad spend ÷ monthly orders</span>
              </div>
              <div class="field">
                <label for="returns-cost">Expected returns/refund cost per order <span class="opt">(optional)</span></label>
                <div class="input-shell">
                  <span class="affix">$</span>
                  <input type="number" id="returns-cost" value="0" min="0" step="0.01" inputmode="decimal" />
                </div>
                <span class="hint">Use your statement history; no unverified formula is preset</span>
              </div>
            </div>
          </div>
        </form>

        <aside class="calc-sticky" aria-label="Results">
          <div class="receipt">
            <div class="receipt-inner">
              <div class="receipt-head">
                <p class="rh-title">TikTok Profit Receipt</p>
                <p class="rh-sub">per order · live</p>
              </div>

              <div class="rline"><span class="rl-label">Selling price</span><span class="rl-dots"></span><span class="rl-val" id="r-price">$0.00</span></div>
              <div class="rline rline--fee"><span class="rl-label">Referral fee <span class="rl-sub-label" id="t-ref-rate">(0%)</span></span><span class="rl-dots"></span><span class="rl-val" id="r-referral">−$0.00</span></div>
              <div class="rline rline--fee"><span class="rl-label">Affiliate commission</span><span class="rl-dots"></span><span class="rl-val" id="r-affiliate">−$0.00</span></div>
              <div class="rline rline--fee"><span class="rl-label">Ad cost</span><span class="rl-dots"></span><span class="rl-val" id="r-ads">−$0.00</span></div>
              <div class="rline rline--fee"><span class="rl-label">Fulfillment</span><span class="rl-dots"></span><span class="rl-val" id="r-fulfillment">−$0.00</span></div>
              <div class="rline rline--fee"><span class="rl-label">Returns/refund cost <span class="opt">(expected)</span></span><span class="rl-dots"></span><span class="rl-val" id="r-refund">−$0.00</span></div>

              <div class="rline rline--total">
                <span class="rl-label">Net revenue</span>
                <span class="rl-dots"></span>
                <span class="rl-val num" id="r-net" aria-live="polite">$0.00</span>
              </div>
              <div class="rline rline--fee"><span class="rl-label">Product cost</span><span class="rl-dots"></span><span class="rl-val" id="r-cost">−$0.00</span></div>

              <div class="rline rline--total">
                <span class="rl-label">Profit / unit</span>
                <span class="rl-dots"></span>
                <span class="rl-val num" id="r-profit" aria-live="polite">$0.00</span>
              </div>
              <div class="rline rline--meta"><span class="rl-label">Margin</span><span class="rl-dots"></span><span class="rl-val" id="r-margin">0%</span></div>
              <div class="rline rline--meta"><span class="rl-label">Total platform take</span><span class="rl-dots"></span><span class="rl-val" id="r-take">0%</span></div>

              <div class="verdict pos" id="r-verdict">profitable ✓</div>

              <button type="button" class="copy-btn" id="copy-btn">Copy results</button>

              <p class="disclaimer">
                Referral and returns fields deliberately have no marketplace
                preset. Copy current values from Seller Center and your own
                statements. Affiliate commission is blended by the share you enter.
              </p>
            </div>
            <div class="tear"></div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section why">
    <div class="wrap">
      <div class="prose">
        <p class="eyebrow">How the math works</p>
        <h2>Use account-specific rates, then stack every order cost</h2>
        <p>
          TikTok Shop fee schedules can change by category and effective date.
          This calculator therefore treats the referral rate as an account input,
          not a universal platform constant. Copy the percentage shown in Seller
          Center, then add the costs that apply to your own order flow.
        </p>
        <div class="formula-box">
          referral = (price + shipping_to_buyer) × referral_rate%
        </div>

        <h3>Blend affiliate commission correctly</h3>
        <p>
          Creator commission only applies to attributed orders. Enter both the
          commission rate you offered and the share of orders attributed to
          affiliates so the calculator can estimate a blended per-order cost.
        </p>
        <div class="formula-box">
          affiliate_cost = price × commission% × affiliate_share%
        </div>

        <h3>Use observed costs for ads, fulfillment, and returns</h3>
        <p>
          Enter ad spend per order, the fulfillment or shipping cost you pay,
          and an expected returns/refund cost based on your own statements. The
          returns field is manual because a public current refund-fee formula
          could not be verified during this review.
        </p>
        <div class="formula-box">
          profit = price + shipping − referral − affiliate − ads − fulfillment − returns_cost − product_cost
        </div>
        <p>
          Use the <a href="/tools/roas-break-even-calculator/">ROAS break-even calculator</a>
          to find the maximum ad cost your margin can absorb, and the <a href="/tools/break-even-units-calculator/">break-even units calculator</a>
          to translate the resulting per-order margin into a sales target.
        </p>
      </div>
    </div>
  </section>

  <section class="section--tight section">
    <div class="wrap"><div class="prose">
      <h2>Official source and verification date</h2>
      <p>
        TikTok Shop's official Seller Academy was re-checked on <strong>{verifiedDate}</strong>. Its public search exposes a later “Referral Fee Update starting August 4th 2026,” but the previously cited public category-fee article now returns 404. Because the current category table and refund formula could not be verified on a live official page, this calculator no longer supplies either preset. Confirm both in <a href={tiktokAcademySource} rel="nofollow">TikTok Shop Seller Academy / Seller Center</a> before pricing.
      </p>
    </div></div>
  </section>

  <section class="section--tight section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Questions</p>
          <h2>TikTok Shop fee calculator FAQ</h2>
        </div>
      </div>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="faq-body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section--tight section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Keep calculating</p>
          <h2>Other free tools</h2>
        </div>
      </div>
      <div class="tool-grid">
        {related.map((t, i) => <ToolCard tool={t} delayClass={`rise-${Math.min(i + 1, 4)}`} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 720px;
    margin-bottom: 40px;
    display: grid;
    gap: 14px;
  }
  .opt {
    font-weight: 400;
    opacity: 0.6;
    font-size: 0.85em;
  }
  .rl-sub-label {
    opacity: 0.6;
    font-size: 0.85em;
    margin-left: 4px;
  }
</style>

<script>
  function $<T extends HTMLElement = HTMLInputElement>(id: string): T {
    return document.getElementById(id) as T;
  }

  const money = (n: number) =>
    n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
  const pct = (n: number) => `${n.toFixed(1)}%`;

  function read(id: string): number {
    const v = parseFloat($(id).value);
    return Number.isFinite(v) && v >= 0 ? v : 0;
  }

  function recalc() {
    const price = read('price');
    const shipping = read('shipping');
    const cost = read('cost');
    const fulfillment = read('fulfillment');
    const affiliatePct = Math.min(read('affiliate'), 100);
    const affiliateShare = Math.min(read('affiliate-share'), 100);
    const ads = read('ads');
    const returnsCost = read('returns-cost');
    const refRate = Math.min(read('referral'), 100);
    $('t-ref-rate').textContent = `(${refRate}%)`;

    const orderValue = price + shipping;
    const referral = orderValue * (refRate / 100);
    const affiliateCost = price * (affiliatePct / 100) * (affiliateShare / 100);

    const totalFees = referral + affiliateCost + ads + fulfillment + returnsCost;
    const netRevenue = orderValue - totalFees;
    const profit = netRevenue - cost;
    const margin = price > 0 ? (profit / price) * 100 : 0;
    const platformTake = price > 0 ? (totalFees / price) * 100 : 0;

    $('r-price').textContent = money(price);
    $('r-referral').textContent = `−${money(referral)}`;
    $('r-affiliate').textContent = `−${money(affiliateCost)}`;
    $('r-ads').textContent = `−${money(ads)}`;
    $('r-fulfillment').textContent = `−${money(fulfillment)}`;
    $('r-refund').textContent = `−${money(returnsCost)}`;
    $('r-net').textContent = money(netRevenue);
    $('r-cost').textContent = `−${money(cost)}`;

    const profitEl = $('r-profit');
    profitEl.textContent = (profit < 0 ? '−' : '') + money(Math.abs(profit));
    profitEl.classList.toggle('pos', profit >= 0);
    profitEl.classList.toggle('neg', profit < 0);

    $('r-margin').textContent = pct(margin);
    $('r-take').textContent = pct(platformTake);

    const verdict = $('r-verdict');
    if (profit < 0) {
      verdict.className = 'verdict neg';
      verdict.textContent = 'selling at a loss ✕';
    } else if (margin >= 30) {
      verdict.className = 'verdict pos';
      verdict.textContent = 'healthy margin ✓';
    } else if (margin >= 15) {
      verdict.className = 'verdict pos';
      verdict.textContent = 'profitable — watch ad costs';
    } else if (margin >= 5) {
      verdict.className = 'verdict pos';
      verdict.textContent = 'thin margin — optimize ads';
    } else {
      verdict.className = 'verdict neg';
      verdict.textContent = 'barely breaking even ✕';
    }
  }

  ['price', 'shipping', 'cost', 'fulfillment', 'affiliate', 'affiliate-share', 'ads', 'returns-cost', 'referral'].forEach(
    (id) => $(id).addEventListener('input', recalc)
  );

  const copyBtn = document.getElementById('copy-btn')!;
  copyBtn.addEventListener('click', async () => {
    const lines = [
      'TikTok Shop profit (emallsoon.com)',
      `Selling price:        ${$('r-price').textContent}`,
      `Referral fee:         ${$('r-referral').textContent}`,
      `Affiliate commission: ${$('r-affiliate').textContent}`,
      `Ad cost:              ${$('r-ads').textContent}`,
      `Fulfillment:          ${$('r-fulfillment').textContent}`,
      `Returns/refund cost:  ${$('r-refund').textContent}`,
      `Net revenue:          ${$('r-net').textContent}`,
      `Product cost:         ${$('r-cost').textContent}`,
      `Profit/unit:          ${$('r-profit').textContent}`,
      `Margin:               ${$('r-margin').textContent}`,
      `Total platform take:  ${$('r-take').textContent}`,
    ];
    try {
      await navigator.clipboard.writeText(lines.join('\n'));
      copyBtn.textContent = 'Copied ✓';
    } catch {
      copyBtn.textContent = 'Copy failed — select manually';
    }
    setTimeout(() => (copyBtn.textContent = 'Copy results'), 1800);
  });

  recalc();
</script>
