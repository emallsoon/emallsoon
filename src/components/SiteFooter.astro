---
import { tools } from '../data/tools';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="f-wordmark">emallsoon<em>.</em></p>
        <p class="f-tagline">
          Free profit calculators for online sellers. Every tool runs entirely
          in your browser — no signup, no data leaves your device.
        </p>
      </div>

      <nav aria-label="Tools">
        <p class="f-heading">Tools</p>
        <ul>
          {
            tools.map((t) => (
              <li>
                <a href={t.href}>{t.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Site">
        <p class="f-heading">Site</p>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about/">About &amp; methodology</a></li>
          <li><a href="/sitemap-index.xml">Sitemap</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>© {year} emallsoon.com — built by sellers, for sellers.</p>
      <p class="f-legal">
        Not affiliated with Amazon, Shopify, Etsy, or any advertising platform.
        Fee rates are editable estimates — always verify current rates on each
        platform.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgba(250, 247, 239, 0.92);
    margin-top: 80px;
    padding: 56px 0 32px;
    /* ledger lines in footer */
    background-image:
      linear-gradient(rgba(250, 247, 239, 0.05) 1px, transparent 1px);
    background-size: 100% 28px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(250, 247, 239, 0.16);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .f-wordmark {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 640;
    margin: 0 0 10px;
  }

  .f-wordmark em {
    color: var(--green-bright);
    font-style: normal;
  }

  .f-tagline {
    font-size: 0.92rem;
    color: rgba(250, 247, 239, 0.6);
    max-width: 34ch;
    line-height: 1.65;
  }

  .f-heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(250, 247, 239, 0.5);
    margin: 0 0 14px;
  }

  footer nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  footer nav a {
    color: rgba(250, 247, 239, 0.85);
    text-decoration: none;
    font-size: 0.92rem;
  }

  footer nav a:hover {
    color: var(--green-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 24px;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.84rem;
    color: rgba(250, 247, 239, 0.55);
  }

  .f-legal {
    max-width: 52ch;
    text-align: right;
  }

  @media (max-width: 760px) {
    .f-legal {
      text-align: left;
    }
  }
</style>
