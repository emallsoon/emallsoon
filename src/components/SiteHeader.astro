---
const isHome = Astro.url.pathname === '/';
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="wordmark" aria-label="emallsoon home">
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="23" height="23" rx="5" stroke="currentColor" stroke-width="2"></rect>
        <path d="M8 8.5l-2.5 4.5L8 17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M18 8.5l2.5 4.5L18 17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M14.5 7.5l-3 11" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <span>emallsoon<em class="dot">.</em></span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <a href="/#tools" class={isHome ? 'active' : ''}>Tools</a>
      <a href="/tools/amazon-fba-profit-calculator/">FBA Calculator</a>
      <a href="/about/">About</a>
    </nav>

    <a href="/#tools" class="btn btn--primary nav-cta">Free calculators</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 247, 239, 0.88);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom: 1.5px solid var(--ink);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 640;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .wordmark .dot {
    color: var(--green);
    font-style: normal;
  }

  .site-nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
  }

  .site-nav a {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .site-nav a:hover,
  .site-nav a.active {
    color: var(--green);
  }

  .nav-cta {
    padding: 10px 18px;
    font-size: 0.86rem;
  }

  @media (max-width: 860px) {
    .site-nav {
      display: none;
    }

    .nav-cta {
      margin-left: auto;
    }
  }
</style>
